<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Parallel Suite"
       parallel="classes"
       thread-count="3">

    <listeners>
        <listener class-name="com.itihas.listeners.TestListener"/>
    </listeners>

    <test name="Parallel UI Tests">

        <classes>
            <class name="com.itihas.tests.LoginTest"/>
            <class name="com.itihas.tests.FindTotalProducts"/>
            <class name="com.itihas.tests.ProductsChearerThanTwenty"/>
        </classes>

    </test>

</suite>